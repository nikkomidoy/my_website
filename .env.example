DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://nikkomidoy@localhost:5433/nikkocomidoy?conn_max_age=60&conn_health_checks=True
# Number of reverse proxies in front of Django (1 behind Caddy in prod)
AXES_IPWARE_PROXY_COUNT=0
# Public domain (used for MFA issuer, Sites framework, absolute links)
DJANGO_SITE_DOMAIN=localhost:8000
# S3 static + media (leave bucket empty in dev to use local ./media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
# CloudFront / custom CDN domain, e.g. cdn.example.com
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_URL_PROTOCOL=https:
# Email — prod SMTP (e.g. Amazon SES: email-smtp.us-east-1.amazonaws.com)
DEFAULT_FROM_EMAIL=webmaster@localhost
# SERVER_EMAIL=  (defaults to DEFAULT_FROM_EMAIL)
# Comma-separated admin emails for error reports
DJANGO_ADMINS=
DJANGO_MAIL_HOST=
DJANGO_MAIL_PORT=587
DJANGO_MAIL_USE_TLS=True
DJANGO_MAIL_USERNAME=
DJANGO_MAIL_PASSWORD=
DJANGO_MAIL_TIMEOUT=10
# Absolute sitemap URL for robots.txt, e.g. https://example.com/sitemap.xml
SITEMAP_URL=
# Local time zone (drives the daily blog/Facebook cron)
DJANGO_TIME_ZONE=America/Toronto
# Set True on staging/preview to keep crawlers out
ROBOTS_DISALLOW_ALL=False
# GoatCounter (SaaS): ANALYTICS_ID=<code>, ANALYTICS_HOST=https://<code>.goatcounter.com
ANALYTICS_ID=
ANALYTICS_HOST=
# Production-only (ignored by local settings)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=
# Sentry DSN (prod only)
SENTRY_DSN=
# GDPR: days to keep login-attempt records
PRIVACY_LOGIN_ATTEMPT_RETENTION_DAYS=30
# Private bucket for pg_dump backups (separate from media)
DBBACKUP_BUCKET=
# Blog automation — crontab schedule in DJANGO_TIME_ZONE (default 09:00 daily)
BLOG_DAILY_CRON=0 9 * * *
# Facebook Page (long-lived Page token with pages_manage_posts)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
# Claude fallback drafts when the queue is empty
ANTHROPIC_API_KEY=
BLOG_AI_FALLBACK_ENABLED=True
# False = AI drafts wait in "Needs review" until you queue them
BLOG_AI_AUTO_PUBLISH=False
BLOG_AI_MODEL=claude-opus-5-5
