# Copy to /srv/nikkocomidoy/deploy/.env.prod on the EC2 host and fill in.
# Never commit the real file.

# Django
# manage.py defaults to config.settings.local — without this, prod runs with NO hardening.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# localhost/127.0.0.1 for the container healthcheck; `web` for Caddy's active probe.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Caddy terminates TLS
DJANGO_BEHIND_PROXY=True
DJANGO_SITE_DOMAIN=example.com
DJANGO_TIME_ZONE=America/Toronto
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/postgres?conn_max_age=60&conn_health_checks=True
# gunicorn worker count — 2×cores+1 for sync workers
WEB_CONCURRENCY=3
# One reverse proxy (Caddy) in front of Django
AXES_IPWARE_PROXY_COUNT=1

# Postgres
POSTGRES_PASSWORD=CHANGE_ME

# Image
GITHUB_REPOSITORY=owner/repo

# S3 static + media (public-read on static/* and media/* via bucket policy)
# Leave both keys EMPTY on EC2: the app uses the instance role (docs/aws-setup.md).
# Only set them when running outside AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
# Optional CloudFront domain, e.g. cdn.example.com
AWS_S3_CUSTOM_DOMAIN=
# Private bucket for nightly pg_dump backups
DBBACKUP_BUCKET=

# Email — Gmail SMTP with an app password (docs/aws-setup.md section 3).
# Gmail only sends as the signed-in address, so FROM must be that Gmail address.
DEFAULT_FROM_EMAIL=Nikko Comidoy <nikkomidoy@gmail.com>
DJANGO_ADMINS=nikkomidoy@gmail.com
DJANGO_MAIL_HOST=smtp.gmail.com
DJANGO_MAIL_PORT=587
DJANGO_MAIL_USE_TLS=True
DJANGO_MAIL_USERNAME=nikkomidoy@gmail.com
# 16-character Google app password (not your normal Gmail password)
DJANGO_MAIL_PASSWORD=

# SEO / analytics / errors
SITEMAP_URL=https://example.com/sitemap.xml
ROBOTS_DISALLOW_ALL=False
ANALYTICS_ID=
ANALYTICS_HOST=
SENTRY_DSN=

# Blog automation
BLOG_DAILY_CRON=0 9 * * *
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
ANTHROPIC_API_KEY=
BLOG_AI_FALLBACK_ENABLED=True
BLOG_AI_AUTO_PUBLISH=False
PRIVACY_LOGIN_ATTEMPT_RETENTION_DAYS=30
